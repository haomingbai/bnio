@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET bexec::bexec)
  find_dependency(bexec @BNIO_BEXEC_MIN_VERSION@ CONFIG)
endif()

if((@BNIO_PLATFORM_LINUX@ OR @BNIO_PLATFORM_BSD@) AND
   (NOT TARGET OpenSSL::SSL OR NOT TARGET OpenSSL::Crypto))
  find_dependency(OpenSSL)
endif()

if(@BNIO_PLATFORM_LINUX@ AND NOT TARGET PkgConfig::LIBURING)
  find_dependency(PkgConfig)
  pkg_check_modules(LIBURING REQUIRED IMPORTED_TARGET liburing>=2.1)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/bnioTargets.cmake")

check_required_components(bnio)
