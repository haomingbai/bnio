prefix=${pcfiledir}/@BUPP_PC_PREFIX_RELATIVE@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: bupp
Description: @PROJECT_DESCRIPTION@
URL: https://github.com/haomingbai/bupp
Version: @PROJECT_VERSION@
Requires: @BUPP_PC_REQUIRES@
Libs: -L${libdir} -lbupp
Cflags: -I${includedir}@BUPP_PC_SHARED_CFLAGS@
